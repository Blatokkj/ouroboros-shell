#!/usr/bin/env bash

set -u

wallpaper_dir="${ARCHBLATO_WALLPAPER_DIR:-$HOME/Imagens/wallpapers}"
archblato_config="${ARCHBLATO_CONFIG_ROOT:-$HOME/.config}"
hyprpaper_config="$archblato_config/hypr/hyprpaper.conf"
preview_dir="${TMPDIR:-/tmp}/archblato-wallpaper-previews-$UID"

current_wallpaper() {
    sed -n '/^[[:space:]]*path[[:space:]]*=/ {
        s/^[[:space:]]*path[[:space:]]*=[[:space:]]*//
        p
        q
    }' "$hyprpaper_config" 2>/dev/null
}

case "${1:-list}" in
    list)
        if [[ ! -d "$wallpaper_dir" || ! -r "$wallpaper_dir" ]]; then
            printf 'Pasta de wallpapers indisponível: %s\n' "$wallpaper_dir" >&2
            exit 1
        fi
        printf 'CURRENT\t%s\n' "$(current_wallpaper)"
        while IFS= read -r -d '' image_path; do
            mime_type=$(file -Lb --mime-type -- "$image_path")
            case "$mime_type" in
                image/jpeg|image/png)
                    printf 'FILE\t%s\t%s\n' "$(stat -c '%Y' -- "$image_path")" "$image_path"
                    ;;
                image/webp)
                    mkdir -p -- "$preview_dir"
                    preview_name=$(printf '%s' "$image_path" | sha256sum | cut -d ' ' -f 1)
                    preview_path="$preview_dir/$preview_name.png"
                    if [[ ! -f "$preview_path" || "$image_path" -nt "$preview_path" ]]; then
                        magick "$image_path" -auto-orient -thumbnail '480x270^' \
                            -gravity center -extent 480x270 "$preview_path" 2>/dev/null || continue
                    fi
                    printf 'PREVIEW\t%s\t%s\t%s\n' "$(stat -c '%Y' -- "$image_path")" "$image_path" "$preview_path"
                    ;;
            esac
        done < <(find "$wallpaper_dir" -maxdepth 1 -type f \
            \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
            -print0 2>/dev/null) \
            | sort -t $'\t' -k2,2nr \
            | cut -f1,3-
        ;;
    set)
        requested="${2:-}"
        canonical_dir=$(realpath -e -- "$wallpaper_dir") || exit 1
        canonical_path=$(realpath -e -- "$requested") || exit 1

        # These characters cannot safely round-trip through hyprpaper's config/IPC.
        if [[ "$canonical_path" == *$'\n'* || "$canonical_path" == *$'\r'* || "$canonical_path" == *$'\t'* || "$canonical_path" == *,* ]]; then
            printf 'Nome do wallpaper contém separadores não suportados.\n' >&2
            exit 1
        fi

        case "$canonical_path" in
            "$canonical_dir"/*) ;;
            *) printf 'Wallpaper fora da pasta permitida.\n' >&2; exit 1 ;;
        esac

        case "${canonical_path,,}" in
            *.jpg|*.jpeg|*.png|*.webp) ;;
            *) printf 'Formato de imagem não suportado.\n' >&2; exit 1 ;;
        esac

        mime_type=$(file -Lb --mime-type -- "$canonical_path")
        case "$mime_type" in
            image/jpeg|image/png|image/webp) ;;
            *) printf 'A instalação atual não decodifica esta imagem.\n' >&2; exit 1 ;;
        esac

        # Serialize changes across monitors; the kernel releases this lock on exit.
        mkdir -p -- "$archblato_config/archblato" || exit 1
        exec 9>"$archblato_config/archblato/.wallpaper.lock" || exit 1
        flock -n 9 || { printf 'Outra troca de wallpaper está em andamento.\n' >&2; exit 1; }

        hyprctl hyprpaper wallpaper ", $canonical_path, cover" || exit 1

        config_dir=$(dirname -- "$hyprpaper_config")
        mkdir -p -- "$config_dir"
        temporary=$(mktemp "$config_dir/.hyprpaper.conf.XXXXXX") || exit 1
        printf 'preload = %s\n\nwallpaper {\n    monitor = \n    path = %s\n    fit_mode = cover\n}\n\nsplash = false\n' \
            "$canonical_path" "$canonical_path" > "$temporary"
        mv -- "$temporary" "$hyprpaper_config" || exit 1
        printf '%s\n' "$canonical_path"
        # Wallpaper succeeded even if the color pipeline fails. UI reports partial success.
        node "$(dirname -- "$0")/wallpaper-theme.cjs" --apply "$canonical_path"
        theme_status=$?
        if [[ "$theme_status" -eq 3 ]]; then exit 3; fi
        if [[ "$theme_status" -ne 0 ]]; then exit 2; fi
        ;;
    current)
        current_wallpaper
        ;;
    *)
        printf 'Uso: %s {list|set CAMINHO|current}\n' "$0" >&2
        exit 2
        ;;
esac
