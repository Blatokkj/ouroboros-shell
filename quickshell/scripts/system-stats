#!/usr/bin/env bash

read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat

total=$((user + nice + system + idle + iowait + irq + softirq + steal))
idle_total=$((idle + iowait))

read -r memory_percentage memory_used_kib memory_total_kib < <(awk '
    /^MemTotal:/ { total = $2 }
    /^MemAvailable:/ { available = $2 }
    END {
        used = total - available
        if (total > 0)
            printf "%.4f %.0f %.0f", 100 * used / total, used, total
        else
            print "0 0 0"
    }
' /proc/meminfo)

brightness_percentage=0
for device in /sys/class/backlight/*; do
    if [[ -r "$device/brightness" && -r "$device/max_brightness" ]]; then
        read -r brightness < "$device/brightness"
        read -r max_brightness < "$device/max_brightness"
        if ((max_brightness > 0)); then
            brightness_percentage=$((100 * brightness / max_brightness))
        fi
        break
    fi
done

temperature=0
for thermal_zone in /sys/class/thermal/thermal_zone*/temp; do
    if [[ -r "$thermal_zone" ]]; then
        read -r temperature < "$thermal_zone"
        if ((temperature > 1000)); then
            temperature=$((temperature / 1000))
        fi
        break
    fi
done

read -r uptime _ < /proc/uptime
uptime=${uptime%.*}
read -r load_one _ < /proc/loadavg

printf '%s %s %s %s %s %s %s %s %s\n' \
    "$total" "$idle_total" "$memory_percentage" "$brightness_percentage" \
    "$temperature" "$uptime" "$memory_used_kib" "$memory_total_kib" "$load_one"
